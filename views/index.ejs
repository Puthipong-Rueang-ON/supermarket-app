<h1>Product List</h1>
<a href="/add">Add Product</a>

<table border="1">
<tr>
<th>Name</th>
<th>Stock</th>
<th>Image</th>
<th>Action</th>
</tr>

<% products.forEach(p => { %>
<tr>
<td><%= p.name %></td>

<td>
<% if(p.stock == 0){ %>
<span style="color:red;">Out of Stock</span>
<% } else { %>
<%= p.stock %>
<% } %>
</td>

<td>
<% if(p.image){ %>
<img src="/uploads/<%= p.image %>" width="80">
<% } %>
</td>

<td>
<a href="/edit/<%= p.id %>">Edit</a>
<a href="/delete/<%= p.id %>">Delete</a>
</td>
</tr>
<% }) %>

</table>